# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 环境变量（含密钥，永不入库）
.env
.env.local
*.env.local

# 运行产物
#
# ⚠️ 必须写成**具体路径**而不是裸 `runs/`。裸模式会匹配任意层级的同名目录，
# 于是 `gateway/src/main/java/dev/parallax/gateway/runs/`（Java 的运行记录包）
# 会被整包忽略掉——本机能编译，CI 上却是 "package does not exist"。
# 这个坑真实发生过：本地 41 项测试全绿、推送后 CI 编译失败，
# 因为 CI 看到的是一个缺了整个包的仓库。
/runs/
/backend/runs/
/eval/real/*.log
*.log

# Node / 前端
node_modules/
.next/
.tmp-test/
out/
dist/

# 本地构建工具链（便携 node / jdk / maven，约 450 MB）
# ⚠️ 绝不能入库：它只是为了让本机在没装全局工具时也能构建，
# 不是项目产物。CI 里由 setup-python / setup-java / setup-node 自行提供。
.toolchain/

# Java
target/
*.class

# labs：Java 语言服务器把工程输出写到 bin/，属于构建产物
labs/*/bin/

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 评测产物只留在本地，不随仓库分发。
# 原因：逐条 claim 明细含被审代码的原文引用（quote）与推理过程，
# 部分实验还跑在第三方开源项目上，报告里带着它们的代码片段。
#
# 但下面三类是**工程验收证据**，不涉及召回测算，必须入库：
#   java-platform  真实 broker / MySQL / 多实例 / PR 接入 / Worker 执行器 / 容器隔离
#   labs           语言与中间件实验记录
#   acceptance     修复流程与 Java 缺陷样本的验收结论
eval/*
!eval/java-platform/
!eval/labs/
!eval/acceptance/

# 修复流证据里有代码 diff、模型提案原文与逐条 claim，仍只留本地
eval/acceptance/20261020/repair/claims.json
eval/acceptance/20261020/repair/original-model-proposal.json
eval/acceptance/20261020/repair/proposal.json
eval/acceptance/20261020/repair/review.diff
eval/acceptance/20261020/repair/verification.json

# 实验切片里的第三方项目源码不进公开仓库：
# 上游仓库未附许可证，重分发有版权风险；切片本身可用
# backend/tools/build_slices.py 从上游按 import 闭包重建，slices.json 记着参数与哈希。
exp-20261029-v4/p0-slices/*/repo/
exp-20261029-v4/p0-slices/*/tests_verify/

# 子采样语料里的源码同样是上游第三方代码，不进公开仓库；
# ground_truth.json 与 subsample.json（采样清单）要进库，保证可复算。
exp-20261029-v4/p1-subsample/*/repo/

# 实验运行的终端日志：体积大、含大量重试刷屏，结论已提炼进 PROGRESS/LEDGER。
exp-20261029-v4/*.log
