# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 环境变量（含密钥，永不入库）
.env
.env.local
*.env.local

# 运行产物
#
# ⚠️ 必须写成**具体路径**而不是裸 `runs/`。裸模式会匹配任意层级的同名目录，
# 于是 `gateway/src/main/java/dev/parallax/gateway/runs/`（Java 的运行记录包）
# 会被整包忽略掉——本机能编译，CI 上却是 "package does not exist"。
# 这个坑真实发生过：本地 41 项测试全绿、推送后 CI 编译失败，
# 因为 CI 看到的是一个缺了整个包的仓库。
/runs/
/backend/runs/
/eval/real/*.log
*.log

# Node / 前端
node_modules/
.next/
out/
dist/

# 本地构建工具链（便携 node / jdk / maven，约 450 MB）
# ⚠️ 绝不能入库：它只是为了让本机在没装全局工具时也能构建，
# 不是项目产物。CI 里由 setup-python / setup-java / setup-node 自行提供。
.toolchain/

# Java
target/
*.class

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
