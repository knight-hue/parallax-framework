# Parallax 环境变量
# 复制为 .env 后填写。.env 已被 .gitignore 排除，密钥不会入库。

# ===== 模型（必填）=====
PARALLAX_LLM_API_KEY=
PARALLAX_LLM_BASE_URL=https://api.deepseek.com/v1
PARALLAX_LLM_MODEL=deepseek-chat
PARALLAX_LLM_TEMPERATURE=0.0
PARALLAX_LLM_TIMEOUT_S=90
PARALLAX_LLM_MAX_RETRIES=3
PARALLAX_LLM_USE_JSON_MODE=true

# ===== 盲读与聚合（核心实验旋钮）=====
# 每条证据分给几个 Reader。
#   2 = 默认，独立性与可验证性平衡
#   1 = 《最终方案》字面的严格分区（第一轮全是孤证，靠补检产生交叉验证）
#   3 = 与 readers 相同 ⇒ 所有人都看全部证据，即「无信息不对称」的对照组
PARALLAX_REDUNDANCY=2
PARALLAX_N_READERS=3

# 判定高置信所需的独立来源数
PARALLAX_SUPPORT_THRESHOLD=2

# 补检轮次上限
PARALLAX_MAX_ROUNDS=3

# 随机种子（分区确定性来源，实验必须固定）
PARALLAX_SEED=0

PARALLAX_MAX_CONCURRENCY=4
PARALLAX_MAX_SCHEMA_RETRIES=2

# 对照组开关：blind = 框架正常模式；shared = 传统协作（Reader 互相可见），仅用于实验对照
PARALLAX_READER_VISIBILITY=blind

# ===== 覆盖率 =====
# 证据被看过几次才算「覆盖到」
PARALLAX_COVERAGE_MIN_SUPPORT=2
# 证据覆盖率硬要求
PARALLAX_MIN_EVIDENCE_FILL_RATE=1.0
PARALLAX_MAX_DISPUTE_RATE=0.5

# ===== 预算护栏（0 = 不限）=====
PARALLAX_MAX_LLM_CALLS=0
PARALLAX_MAX_TOKENS=0

# ===== 运行产物 =====
PARALLAX_RUNS_DIR=runs
