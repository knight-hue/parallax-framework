# Parallax 环境变量
# 复制为 .env 后填写。.env 已被 .gitignore 排除，密钥不会入库。

# ===== 模型（必填）=====
OPENAI_API_KEY=
PARALLAX_LLM_BASE_URL=https://api.openasi.bitmiracle.cn/v1
PARALLAX_LLM_MODEL=gpt-6.1-sol
PARALLAX_LLM_TEMPERATURE=0.0
PARALLAX_LLM_TIMEOUT_S=90
PARALLAX_LLM_MAX_RETRIES=3
PARALLAX_LLM_USE_JSON_MODE=true

# ===== 盲读与聚合（核心实验旋钮）=====
# 每条证据分给几个 Reader。
#   2 = 默认，独立性与可验证性平衡
#   1 = 《最终方案》字面的严格分区（第一轮全是孤证，靠补检产生交叉验证）
#   3 = 与 readers 相同 ⇒ 所有人都看全部证据，即「无信息不对称」的对照组
PARALLAX_REDUNDANCY=2
PARALLAX_N_READERS=3

# 判定高置信所需的独立来源数
PARALLAX_SUPPORT_THRESHOLD=2

# 补检轮次上限
PARALLAX_MAX_ROUNDS=3

# 随机种子（分区确定性来源，实验必须固定）
PARALLAX_SEED=0

PARALLAX_MAX_CONCURRENCY=4
PARALLAX_MAX_SCHEMA_RETRIES=2

# 对照组开关：blind = 框架正常模式；shared = 传统协作（Reader 互相可见），仅用于实验对照
PARALLAX_READER_VISIBILITY=blind

# ===== 覆盖率 =====
# 证据被看过几次才算「覆盖到」
PARALLAX_COVERAGE_MIN_SUPPORT=2
# 证据覆盖率硬要求
PARALLAX_MIN_EVIDENCE_FILL_RATE=1.0
PARALLAX_MAX_DISPUTE_RATE=0.5

# ===== 预算护栏（0 = 不限）=====
PARALLAX_MAX_LLM_CALLS=0
PARALLAX_MAX_TOKENS=0

# ===== 运行产物 =====
PARALLAX_RUNS_DIR=runs

# ===== 完成回调（配合 Java 网关，默认关闭）=====
# 一次审查结束后把用量回报给网关，让配额与报表反映真实消耗。
# 留空 = 不回调。脱离网关单独跑本服务时不要打开：那个地址根本不存在，
# 每次运行都会白等一次超时（虽然只记 WARN，不影响运行结果）。
PARALLAX_CALLBACK_URL=
# 与网关的 PARALLAX_GATEWAY_INTERNAL_TOKEN 一致
PARALLAX_CALLBACK_TOKEN=

# ===== 可选进阶功能（执行默认关闭）=====
PARALLAX_LLM_REASONING_EFFORT=
PARALLAX_ENABLE_LLM_FALSIFIER=false
PARALLAX_ADAPTIVE_SCHEDULING=false
PARALLAX_SEMANTIC_PARTITIONING=false
PARALLAX_SEMANTIC_CLOSURE_HOPS=1
PARALLAX_SEMANTIC_MAX_CONTEXT_UNITS=8
PARALLAX_MIN_INDEPENDENT_SUPPORT=0
PARALLAX_MAX_EVIDENCE_OVERLAP_RATE=1.0
# 独立性准入闸门：off=只记录；observe=报告本应如何处置（默认）；enforce=重分区并在用尽尝试后降级
PARALLAX_INDEPENDENCE_GATE=observe
PARALLAX_MIN_EFFECTIVE_CHANNELS=0
PARALLAX_MIN_NORMALIZED_INDEPENDENCE=0
PARALLAX_MAX_INDEPENDENCE_ATTEMPTS=1
# 争议仲裁器：null=不仲裁（争议保留为 disputed）；blind=规则型结论剥离；llm=模型仲裁；llm-blind=模型仲裁但不把结论交给模型
PARALLAX_ARBITRATOR=null
PARALLAX_ENABLE_REPRODUCTION=false
PARALLAX_ENABLE_REPAIR=false
PARALLAX_REPRODUCTION_IMAGE=parallax-repro:local
PARALLAX_REPRODUCTION_TIMEOUT_S=20
# 生产由网关注入；与网关一致，真实值只填 .env。
PARALLAX_GATEWAY_INTERNAL_TOKEN=
# 平台 Worker：固定私网 Java 地址和精确源码主机白名单；留空不启用。
PARALLAX_PLATFORM_URL=
PARALLAX_PLATFORM_SOURCE_HOSTS=[]
# 续租间隔必须小于 Java 租约（默认 120 秒），并留出网络超时余量。
PARALLAX_PLATFORM_HEARTBEAT_SECONDS=20
PARALLAX_PLATFORM_REPLAY_SECONDS=5
# inline 为同进程执行；process 使用可被 deadline 强制终止的子进程；
# container 在子进程基础上再加容器边界（无网络、只读根文件系统、非 root、cap 全丢）。
PARALLAX_PLATFORM_EXECUTION_MODE=inline
PARALLAX_PLATFORM_MAX_CONCURRENT_TASKS=2
PARALLAX_PLATFORM_PROCESS_TERMINATE_GRACE_SECONDS=2
# 仅 container 模式使用：镜像由 docker/sandbox.Dockerfile 构建；限额交给容器而不是进程。
PARALLAX_PLATFORM_CONTAINER_IMAGE=parallax-engine-sandbox:local
PARALLAX_PLATFORM_CONTAINER_MEMORY_MB=768
PARALLAX_PLATFORM_CONTAINER_CPUS=1
PARALLAX_PLATFORM_CONTAINER_PIDS=128
PARALLAX_PLATFORM_CONTAINER_TMPFS_MB=64
# 生产覆盖配置还要求 PARALLAX_JWT_SECRET / PARALLAX_GATEWAY_ADMIN_SECRET / PARALLAX_DB_PASSWORD。
PARALLAX_CALLBACK_TIMEOUT_S=5

# ===== Java / MySQL（实际值只填 .env，不提交口令）=====
SPRING_PROFILES_ACTIVE=mysql
PARALLAX_MYSQL_URL=jdbc:mysql://127.0.0.1:3306/parallax?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
PARALLAX_DB_USER=parallax
PARALLAX_DB_PASSWORD=
PARALLAX_MYSQL_ROOT_PASSWORD=
