<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>dev.parallax</groupId>
  <artifactId>parallax-gateway</artifactId>
  <version>0.1.0</version>
  <name>parallax-gateway</name>
  <description>Parallax 薄网关：统一入口、鉴权、限流、熔断、SSE 不间断透传</description>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <jjwt.version>0.12.6</jjwt.version>
    <bucket4j.version>8.10.1</bucket4j.version>
    <resilience4j.version>2.2.0</resilience4j.version>
    <springdoc.version>2.8.9</springdoc.version>
    <!--
      默认跳过集成测试：它们要 Docker（Testcontainers 起真实 PostgreSQL 与 Redis）。
      不跳的话，没有 Docker 的机器 `mvn verify` 就会失败——本地开发会被基础设施卡住。
      需要真实基础设施时用 `-Pit`，CI 上的 gateway-it 任务就是这么做。
    -->
    <skipITs>true</skipITs>
  </properties>

  <profiles>
    <profile>
      <!-- 真实 PostgreSQL + Redis 的集成测试 -->
      <id>it</id>
      <properties>
        <skipITs>false</skipITs>
      </properties>
    </profile>
  </profiles>

  <dependencies>
    <!--
      【约定修订 · C1】原本这里写的是"刻意不引入 JPA / Redis / Flyway"，
      理由是"网关一旦依赖数据库就会有人把业务逻辑写进来"。
      该理由仍然成立，但把**平台能力**一起挡在了门外：
      身份、配额、用量记账、运行记录都属于网关的本职，不是业务逻辑。
      业务逻辑（证据怎么装配）始终只由 Python 编排服务负责。

      因此约定修订为：**无编排逻辑，可有平台能力**。
      新增的每个依赖都必须能回答"它服务于身份/配额/持久化/可观测性中的哪一项"，
      答不上来就不该加。修订记录见 CHANGELOG。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>

    <!-- 平台能力：身份 / 配额 / 用量账本 / 运行记录 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-api</artifactId>
      <version>${jjwt.version}</version>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-impl</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-jackson</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>com.bucket4j</groupId>
      <artifactId>bucket4j-core</artifactId>
      <version>${bucket4j.version}</version>
    </dependency>
    <!--
      分布式限流：两个网关实例共享同一份配额。
      bucket4j-redis 对 Jedis/Redisson/Lettuce 都是 provided，必须显式带上 Lettuce。
    -->
    <dependency>
      <groupId>com.bucket4j</groupId>
      <artifactId>bucket4j-redis</artifactId>
      <version>${bucket4j.version}</version>
    </dependency>
    <dependency>
      <groupId>io.lettuce</groupId>
      <artifactId>lettuce-core</artifactId>
    </dependency>

    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-spring-boot3</artifactId>
      <version>${resilience4j.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-aop</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- /actuator/prometheus：运行量、token 用量、配额拒绝都必须能被外部看到 -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>

    <!-- API 文档。演示与评审需要在浏览器里直接看到端点契约，而不是读源码。 -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      H2 只用于**默认测试档**，让整套测试在没有 Docker 的机器上也能跑：
      同一份 Flyway 迁移脚本在 H2 的 PostgreSQL 兼容模式下执行，
      迁移语法错误因此每次测试都会被暴露。
      真实 PostgreSQL 由 gateway-it（Testcontainers）单独跑一遍——
      H2 无法替代真实 PG 做验证，两者是互补而不是二选一。
    -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <skipITs>${skipITs}</skipITs>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
